# Every setting can be overridden with a RAG_* environment variable. Defaults shown.

RAG_OLLAMA_URL=http://localhost:11434
RAG_LLM_MODEL=llama3.2
RAG_EMBED_MODEL=nomic-embed-text
# Task prefixes for nomic-embed-text; leave both empty for other embedding models.
RAG_QUERY_PREFIX="search_query: "
RAG_DOCUMENT_PREFIX="search_document: "
RAG_TEMPERATURE=0.1

RAG_PERSIST_DIR=.ragkit/chroma
RAG_COLLECTION=docs

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

RAG_TOP_K=5
RAG_CANDIDATE_K=20
# Refuse without calling the LLM when the best match is less similar than this.
RAG_MIN_SIMILARITY=0.55
# Replace answers with missing/invalid citations by a refusal.
RAG_STRICT_GROUNDING=false
